<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#131417">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: App Icon, Name, Package, Specs & Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:layout_marginEnd="12dp"
                tools:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FAFAF9"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="Application Name" />

                <TextView
                    android:id="@+id/tvPackageName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#71717A"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:layout_marginTop="1dp"
                    tools:text="com.example.app" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/tvAppSpecs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#38BDF8"
                        android:textSize="9.5sp"
                        android:fontFamily="monospace"
                        android:layout_marginEnd="8dp"
                        tools:text="v1.0.0 • 12.4 MB • API 33" />

                    <TextView
                        android:id="@+id/tvAppTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USER APP"
                        android:textColor="#38BDF8"
                        android:textSize="8sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:background="#0F2231"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close"
                app:tint="#71717A" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E2026"
            android:layout_marginBottom="10dp" />

        <!-- ACTION 1: OPEN APP -->
        <LinearLayout
            android:id="@+id/btnActionOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPEN APP"
                    android:textColor="#FAFAF9"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Launch application in foreground"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#52525B"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ACTION 2: APP INFO -->
        <LinearLayout
            android:id="@+id/btnActionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:text="ⓘ"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APP INFO"
                    android:textColor="#FAFAF9"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System settings, battery, defaults &amp; notifications"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#52525B"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ACTION 3: APP PERMISSIONS -->
        <LinearLayout
            android:id="@+id/btnActionPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APP PERMISSIONS"
                    android:textColor="#FAFAF9"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage storage, camera, microphone &amp; sensors"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#52525B"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ACTION 4: CLEAR CACHE / STORAGE -->
        <LinearLayout
            android:id="@+id/btnActionCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:text="🧹"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLEAR CACHE &amp; STORAGE"
                    android:textColor="#FAFAF9"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open storage manager to clear cache or wipe data"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#52525B"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ACTION 5: UNINSTALL APP -->
        <LinearLayout
            android:id="@+id/btnActionUninstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:text="🗑"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNINSTALL APP"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvUninstallDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completely remove application from device"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#52525B"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <!-- Horizontal Continuous Panorama Viewport -->
    <HorizontalScrollView
        android:id="@+id/catalogPanoramaScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <LinearLayout
            android:id="@+id/catalogPanoramaCanvas"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingTop="58dp"
            android:paddingBottom="4dp">

            <!-- ============================================== -->
            <!-- PANEL 0: TRACKS                                -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/panelTracks"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvHeaderTracks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="tracks"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />

                <!-- Action Bar for Tracks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvTracksCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 tracks"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/btnSortTracks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sort"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btnShuffleTracks"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="SHUFFLE"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#2A2E45"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnPlayTracks"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="PLAY"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#F97316"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPanoramaTracks"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingEnd="26dp"
                        android:clipToPadding="false"
                        android:paddingBottom="12dp"
                        android:scrollbars="none" />

                    <!-- Alphabet Index Rail -->
                    <com.hana.spindle.ui.AlphabetIndexView
                        android:id="@+id/alphabetIndexTracks"
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="4dp" />

                    <!-- Letter Preview Bubble -->
                    <TextView
                        android:id="@+id/tvLetterPreviewTracks"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_centerInParent="true"
                        android:background="#E6101115"
                        android:gravity="center"
                        android:textColor="@color/vfd_emerald"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:elevation="12dp"
                        android:visibility="gone" />
                </RelativeLayout>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- PANEL 1: ALBUMS                                -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/panelAlbums"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvHeaderAlbums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="albums"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />

                <!-- Action Bar for Albums -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvAlbumsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 albums"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/btnSortAlbums"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sort: A-Z"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPanoramaAlbums"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- PANEL 2: ARTISTS                               -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/panelArtists"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvHeaderArtists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="artists"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvArtistsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 artists"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPanoramaArtists"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- PANEL 3: CASSETTE MIXTAPES                     -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/panelMixtapes"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvHeaderMixtapes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cassette mixtapes"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvMixtapesCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 mixtapes"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/btnNewMixtape"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="+ NEW"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#2A2E45"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPanoramaMixtapes"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- PANEL 4: FOLDERS & SD CARD                     -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/panelFolders"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvHeaderFolders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="folders &amp; sd card"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvFoldersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage folders"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPanoramaFolders"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- PANEL 5: FAVORITES                             -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/panelFavorites"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvHeaderFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="favorites"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvFavoritesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Starred tracks"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPanoramaFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- PANEL 6: COMPOSERS                             -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/panelComposers"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvHeaderComposers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="composers"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvComposersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Composers"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPanoramaComposers"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Parallax Big Kinetic Header (Drawn on top layer with elevation, moves at ~0.22x parallax speed) -->
    <TextView
        android:id="@+id/tvCatalogParallaxTitle"
        style="@style/TextAppearance.Spindle.Metro.Hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="14dp"
        android:layout_marginTop="0dp"
        android:elevation="8dp"
        android:singleLine="true"
        android:ellipsize="none"
        android:text="music collection"
        android:textColor="@color/white" />

</RelativeLayout>

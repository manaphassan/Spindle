<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <!-- 1. Vertical Analog Cassette Deck Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/verticalDeckContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Outer Chassis Faceplate with Ruler & Deck Buttons -->
        <com.hana.spindle.ui.cassette.VerticalDeckView
            android:id="@+id/verticalDeckView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Dynamic Folded Paper J-Card Liner Notes (3D Flip View) -->
        <com.hana.spindle.ui.cassette.JCardLinerView
            android:id="@+id/jCardLinerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Vertical Cassette Tape (Internalized into VerticalDeckView) -->
        <com.hana.spindle.ui.cassette.CassetteView
            android:id="@+id/verticalCassetteView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtle track time overlay (Internalized into VerticalDeckView) -->
        <TextView
            android:id="@+id/tvVerticalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Classic 1981 Metal-81 Red Layout Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/metal81Container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/metal81_red"
        android:visibility="gone">

        <com.hana.spindle.ui.cassette.Metal81ChassisView
            android:id="@+id/metal81ChassisView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.hana.spindle.ui.cassette.CassetteView
            android:id="@+id/metal81CassetteView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="110dp"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="160dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Digital VFD Tape Counter -->
        <LinearLayout
            android:id="@+id/counterContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface_container"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="84dp"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/vfd_emerald"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_time_divider"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/vfd_emerald"
                android:fontFamily="monospace"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Bottom Physical Controls Container -->
        <LinearLayout
            android:id="@+id/bottomControlsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/metal81_bezel_black"
                android:text="@string/player_btn_prev_label"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/metal81_bezel_dark"
                android:text="@string/player_btn_play_label"
                android:textColor="@color/metal81_play_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/metal81_bezel_black"
                android:text="@string/player_btn_next_label"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnEject"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/metal81_red_dark"
                android:text="@string/action_eject"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. Audiophile Dual Analog Needle VU Meter Full-Screen Display -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vuMeterContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0B0E"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <!-- Top Header Navigation & Badges Bar -->
        <LinearLayout
            android:id="@+id/vuTopBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btnVuBackToDeck"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:background="@drawable/bg_vu_pill"
                android:text="◀ CASSETTE"
                android:textColor="@color/brand_pale"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Hi-Res Format Badge -->
            <TextView
                android:id="@+id/tvVuFormatBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:paddingHorizontal="8dp"
                android:gravity="center"
                android:background="@drawable/bg_vu_format_badge"
                android:text="FLAC 96kHz / 24-bit"
                android:textColor="#FDE68A"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Backlight Tone Selector -->
            <TextView
                android:id="@+id/btnVuBacklightTone"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:background="@drawable/bg_vu_pill"
                android:text="AMBER 💡"
                android:textColor="@color/brand_pale"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Track Info Block (Zune Metro Bold Typography) -->
        <LinearLayout
            android:id="@+id/vuTrackInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/vuTopBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvVuTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spindle Direct ALSA"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever" />

            <TextView
                android:id="@+id/tvVuTrackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audiophile Reference Master"
                android:textColor="#A1A1AA"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Dual Analog Galvanometer Needle VU Meter Console -->
        <com.hana.spindle.ui.eq.DualAnalogVuMeterView
            android:id="@+id/vuMeterView"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/vuTrackInfoContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sub-Meter Dynamic Telemetry Indicators -->
        <LinearLayout
            android:id="@+id/vuDynamicsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/vuMeterView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvVuLeftDb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L: -∞ dB"
                android:textColor="#71717A"
                android:textSize="10sp"
                android:singleLine="true"
                android:fontFamily="monospace" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvVuDspMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TYPE I • DOLBY OFF"
                android:textColor="#A1A1AA"
                android:textSize="10sp"
                android:singleLine="true"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvVuRightDb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R: -∞ dB"
                android:textColor="#71717A"
                android:textSize="10sp"
                android:singleLine="true"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Time & Progress Seek Bar -->
        <LinearLayout
            android:id="@+id/vuProgressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/vuDynamicsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvVuCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/vfd_emerald"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekVuProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:paddingHorizontal="10dp"
                android:thumbTint="@color/brand_orange"
                android:progressTint="@color/brand_orange" />

            <TextView
                android:id="@+id/tvVuTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#71717A"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Audiophile Transport Controls Row -->
        <LinearLayout
            android:id="@+id/vuTransportRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/vuProgressRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Repeat Mode -->
            <ImageButton
                android:id="@+id/btnVuRepeat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_metro_circle_button"
                android:src="@drawable/ic_np_repeat"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_secondary"
                android:contentDescription="Repeat Mode" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.8" />

            <!-- Prev Button -->
            <ImageButton
                android:id="@+id/btnVuPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_metro_circle_button"
                android:src="@drawable/ic_np_prev"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/white"
                android:contentDescription="Previous Track" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.8" />

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/btnVuPlayPause"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_play"
                android:src="@drawable/ic_np_play"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:tint="@color/white"
                android:contentDescription="Play/Pause" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.8" />

            <!-- Next Button -->
            <ImageButton
                android:id="@+id/btnVuNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_metro_circle_button"
                android:src="@drawable/ic_np_next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/white"
                android:contentDescription="Next Track" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.8" />

            <!-- Shuffle Mode -->
            <ImageButton
                android:id="@+id/btnVuShuffle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_metro_circle_button"
                android:src="@drawable/ic_np_shuffle"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_secondary"
                android:contentDescription="Shuffle Mode" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.5" />

            <!-- Queue Button -->
            <ImageButton
                android:id="@+id/btnVuQueue"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_metro_circle_button"
                android:src="@drawable/ic_np_queue"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_secondary"
                android:contentDescription="Playback Queue" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

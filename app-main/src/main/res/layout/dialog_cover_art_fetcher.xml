<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121318"
    android:padding="20dp">

    <!-- Header Drag Bar & Title -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#2E3342"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ALBUM ART WORKSHOP"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvFetcherBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE FETCHER"
            android:textColor="#38BDF8"
            android:background="#162534"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Downloads high-resolution album artwork for tracks without embedded tags or folder art. Queries rate-limited iTunes and Deezer catalogs."
        android:textColor="#A1A1AA"
        android:textSize="11.5sp"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="16dp" />

    <!-- Summary Stats Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#1A1C24"
        app:cardElevation="0dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Library Albums:"
                    android:textColor="#71717A"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvTotalAlbumsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- albums"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Missing Cover Art:"
                    android:textColor="#71717A"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvMissingCoversCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculating..."
                    android:textColor="#F97316"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Download Quality:"
                    android:textColor="#71717A"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="600x600 HD (RGB_565)"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Save to local folder toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export cover.jpg to Album Folders"
                android:textColor="#F4F4F5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allows external DAPs, car stereos &amp; players to read art"
                android:textColor="#71717A"
                android:textSize="10.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swSaveToFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Progress Telemetry & Live Log -->
    <LinearLayout
        android:id="@+id/layoutProgressSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <ProgressBar
            android:id="@+id/progressBarFetch"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="#38BDF8"
            android:indeterminateTint="#38BDF8"
            android:indeterminate="false"
            android:progress="0"
            android:max="100" />

        <TextView
            android:id="@+id/tvCurrentFetchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparing download pipeline..."
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnStartFetch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="START DOWNLOAD (MISSING ONLY)"
        android:textColor="@color/white"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:backgroundTint="#0079C1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="8dp" />

    <Button
        android:id="@+id/btnCancelOrDismiss"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="CLOSE"
        android:textColor="#A1A1AA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:backgroundTint="#181A22"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="8dp"
        android:layout_marginTop="8dp" />

</LinearLayout>

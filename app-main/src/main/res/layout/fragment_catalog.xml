<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <!-- Top Container: Header, Search, Filter Chips, Tabs & Sort/Quick Actions -->
    <LinearLayout
        android:id="@+id/catalogHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:background="#151619">

        <!-- Top Bar: Standardized Back Arrow, Title & Integrated Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageButton
                android:id="@+id/btnBackToPlayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_back"
                app:tint="@color/text_primary"
                android:contentDescription="Back to Player" />

            <TextView
                android:id="@+id/tvCatalogHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:text="CATALOG"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:letterSpacing="0.06" />

            <!-- Integrated Header Search Bar (Replaces static 'Ready' text, saves ~46dp vertical space) -->
            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#212228"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/ivSearchIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Search Icon" />

                <EditText
                    android:id="@+id/etCatalogSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@null"
                    android:hint="Search library..."
                    android:textColorHint="#64748B"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/btnSearchClear"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_secondary"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear Search" />

                <TextView
                    android:id="@+id/tvScanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Scanning..."
                    android:textColor="@color/vfd_amber"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- Real-time Autocomplete Suggestions View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="3dp"
            android:background="#1E212A"
            android:elevation="12dp"
            android:maxHeight="200dp"
            android:visibility="gone" />

        <!-- Minimalist 5-Tab Core Navigation -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/tabSongs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="TRACKS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/wm2_red"
                    android:paddingHorizontal="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/tabAlbums"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="ALBUMS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="#212228"
                    android:paddingHorizontal="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/tabArtists"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="ARTISTS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="#212228"
                    android:paddingHorizontal="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/tabFolders"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="FOLDERS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="#212228"
                    android:paddingHorizontal="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/tabFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="FAVORITES"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="#212228"
                    android:paddingHorizontal="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Sub-Header Action Bar: Count, Sort/Group Pill, and Play/Shuffle Buttons -->
        <LinearLayout
            android:id="@+id/actionBarContainer"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvCatalogCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 tracks"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Sort & Group Pill Button -->
            <LinearLayout
                android:id="@+id/btnSortGroup"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#24252C"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/vfd_emerald"
                    android:contentDescription="Sort Icon" />

                <TextView
                    android:id="@+id/tvCurrentSortLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Sort: Title"
                    android:textColor="#E2E8F0"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- New Mixtape Button -->
            <Button
                android:id="@+id/btnNewMixtape"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="NEW TAPE"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/vfd_emerald"
                android:visibility="gone"
                android:paddingHorizontal="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp" />

            <!-- Shuffle Pill Button -->
            <Button
                android:id="@+id/btnShuffle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="SHUFFLE"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:backgroundTint="#2A2B32"
                android:paddingHorizontal="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp" />

            <!-- Play All Pill Button -->
            <Button
                android:id="@+id/btnPlayAll"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:text="PLAY ALL"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/wm2_red"
                android:paddingHorizontal="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#24252B"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Main Content Area with Recycler & Alphabet Rail -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/catalogHeaderContainer"
        android:layout_above="@+id/cardMiniPlayer">

        <!-- Recycler View with padding on right for alphabet index -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCatalog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="26dp"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="16dp" />

        <!-- Alphabet Fast-Scroll Rail -->
        <com.hana.spindle.ui.AlphabetIndexView
            android:id="@+id/catalogAlphabetIndex"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Floating Letter Preview Bubble -->
        <TextView
            android:id="@+id/tvCatalogLetterPreview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerInParent="true"
            android:background="#E6101115"
            android:gravity="center"
            android:textColor="@color/vfd_emerald"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:elevation="12dp"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Persistent Bottom Mini-Player Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMiniPlayer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#1A1B20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <!-- Thumbnail -->
            <ImageView
                android:id="@+id/ivMiniArt"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="#2E2F35"
                android:src="@android:drawable/ic_media_play"
                android:padding="8dp"
                android:contentDescription="Mini Cover" />

            <!-- Title & Artist & Format -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/tvMiniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No Track Loaded"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvMiniArtist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Spindle Player"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvMiniFormat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#242630"
                        android:textColor="@color/vfd_emerald"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:visibility="gone"
                        android:text="FLAC 24/96" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compact Playback Controls -->
            <ImageButton
                android:id="@+id/btnMiniPrev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/text_primary"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/btnMiniPlayPause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_play"
                android:src="@android:drawable/ic_media_play"
                app:tint="#FFFFFF"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/btnMiniNext"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_next"
                app:tint="@color/text_primary"
                android:contentDescription="Next" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3.5. Album Detail View (Track List Inside Album) -->
    <LinearLayout
        android:id="@+id/albumDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#151724"
        android:paddingTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="15dp"
        android:visibility="gone">

        <!-- Top Navigation Bar: Back Arrow, Title, Format -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageButton
                android:id="@+id/btnAlbumDetailBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_back"
                app:tint="@color/text_primary"
                android:contentDescription="Back to Albums" />

            <TextView
                android:id="@+id/tvAlbumDetailHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="ALBUM"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tvAlbumDetailFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#202334"
                android:textColor="@color/vfd_emerald"
                android:textSize="10.5sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="FLAC" />
        </LinearLayout>

        <!-- Stage Header: Dedicated Single Audio Now Playing Concept -->
        <LinearLayout
            android:id="@+id/albumDetailHeaderStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <!-- Hero Button Album Art Cover (Circular Vinyl Disc with Quick Play Button) -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Circular Disc Outer Ring (Vinyl Aesthetic) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAlbumDetailCover"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#202334"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivAlbumDetailCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Album Art Cover" />

                    <!-- Center Vinyl Pip / Ring -->
                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_play"
                        android:backgroundTint="#80000000" />
                </androidx.cardview.widget.CardView>

                <!-- Interactive Play Overlay Badge on Cover Button -->
                <ImageView
                    android:id="@+id/btnAlbumDetailCoverPlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignBottom="@+id/cardAlbumDetailCover"
                    android:layout_alignEnd="@+id/cardAlbumDetailCover"
                    android:background="@drawable/bg_circle_play"
                    android:backgroundTint="@color/wm2_red"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#FFFFFF"
                    android:elevation="8dp"
                    android:contentDescription="Play Album" />
            </RelativeLayout>

            <!-- Album Title & Artist -->
            <TextView
                android:id="@+id/tvAlbumDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Album Title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvAlbumDetailArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Artist Name"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1" />

            <!-- Audiophile Metadata: Year • Tracks • Duration -->
            <TextView
                android:id="@+id/tvAlbumDetailMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="1973 • 10 Tracks • 42:15"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <!-- Tactile Action Pill Buttons: Play All & Shuffle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnAlbumDetailPlayAll"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="PLAY ALL"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/wm2_red"
                    android:paddingHorizontal="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="17dp" />

                <Button
                    android:id="@+id/btnAlbumDetailShuffle"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="10dp"
                    android:text="SHUFFLE"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="#202334"
                    android:paddingHorizontal="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="17dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Separator -->
        <View
            android:id="@+id/vAlbumDetailDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#24252B" />

        <!-- Album Tracks RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlbumTracks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="80dp" />

    </LinearLayout>

    <!-- 4. Now Playing Fullscreen Single Audio Container (Reference Image UI) -->
    <LinearLayout
        android:id="@+id/nowPlayingSingleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0F1016"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="24dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- Top Navigation Bar (< Back, Interactive Format Badge Pill, Spacer, ♡ Favorite, ⋮ Menu) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnNpBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_back"
                app:tint="@color/text_primary"
                android:contentDescription="Back to Catalog" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnNpFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_heart"
                app:tint="#94A3B8"
                android:contentDescription="Favorite" />

            <ImageButton
                android:id="@+id/btnNpMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_more"
                app:tint="@color/text_primary"
                android:contentDescription="Options" />
        </LinearLayout>

        <!-- Center Stage: Hero Circular Vinyl Disc Artwork & Synced Lyrics Drawer -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="12dp">

            <com.hana.spindle.ui.catalog.CircularCoverArcView
                android:id="@+id/circularCoverArcView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Synchronized Live Lyrics Overlay Panel (Toggled by btnNpLyrics or Cover Tap) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNpLyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#F20D0E13"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNpLyrics"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingVertical="36dp"
                        android:paddingHorizontal="16dp"
                        android:clipToPadding="false" />

                    <TextView
                        android:id="@+id/tvNpNoLyrics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:text="No synchronized lyrics available\nTap to return to artwork"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <!-- Track Metadata (Centered, Crisp Audiophile Typography) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvNpTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Track Title"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever" />

            <TextView
                android:id="@+id/tvNpArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="Artist Name"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Actual Song Audio Waveform Visualizer & Seek Scrubber -->
        <com.hana.spindle.ui.catalog.AudioWaveformView
            android:id="@+id/audioWaveformView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="6dp" />

        <!-- Time Readouts (Elapsed Left, Remaining/Total Right) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tvNpCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvNpTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="00:00"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </RelativeLayout>

        <!-- Main Playback Transport: Prev, Circular Play/Pause, Next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/btnNpPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_prev"
                app:tint="@color/text_primary"
                android:contentDescription="Previous Track" />

            <ImageButton
                android:id="@+id/btnNpPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="32dp"
                android:background="@drawable/bg_circle_play"
                android:backgroundTint="@color/wm2_red"
                android:src="@drawable/ic_np_play"
                app:tint="#FFFFFF"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/btnNpNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_next"
                app:tint="@color/text_primary"
                android:contentDescription="Next Track" />
        </LinearLayout>

        <!-- Bottom Actions Bar: Lyrics, Repeat, Shuffle, Queue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnNpLyrics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_lyrics"
                app:tint="#94A3B8"
                android:contentDescription="Lyrics" />

            <ImageButton
                android:id="@+id/btnNpRepeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_repeat"
                app:tint="#94A3B8"
                android:contentDescription="Repeat Mode" />

            <ImageButton
                android:id="@+id/btnNpShuffle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_shuffle"
                app:tint="#94A3B8"
                android:contentDescription="Shuffle Mode" />

            <ImageButton
                android:id="@+id/btnNpQueue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_np_queue"
                app:tint="#94A3B8"
                android:contentDescription="Queue" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>

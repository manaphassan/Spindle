<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_container"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Bottom Sheet Drag Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/divider"
        android:layout_marginBottom="14dp" />

    <!-- Metro Kinetic Pivot Header: queue | lyrics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvMetroQueueTitle"
            style="@style/TextAppearance.Spindle.Metro.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="queue"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvMetroQueueLyricsPivot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="lyrics"
            android:textColor="@color/text_secondary"
            android:textSize="24sp"
            android:fontFamily="sans-serif-light"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Header Row: Title, Meta Info, and Clear Upcoming Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/queue_header_title"
                android:textColor="@color/brand_orange"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQueueSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0 Tracks • 00:00 Remaining"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveQueueMixtape"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/queue_save_mixtape"
            android:textColor="@color/brand_orange"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface_card"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:layout_marginEnd="6dp"
            app:cornerRadius="@dimen/corner_radius_metro" />

        <Button
            android:id="@+id/btnClearUpcoming"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/queue_clear_upcoming"
            android:textColor="@color/brand_pink"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface_card"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            app:cornerRadius="@dimen/corner_radius_metro" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvQueueEmpty"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="center"
        android:text="@string/queue_empty_message"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.2"
        android:visibility="gone" />

    <!-- Active Queue List with Drag-and-Drop and Swipe Support -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueueItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="4dp"
        android:clipToPadding="false" />

    <!-- Bottom Application Bar: now playing (with circular wireframe back button) -->
    <LinearLayout
        android:id="@+id/layoutQueueNowPlayingReturn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageButton
            android:id="@+id/btnQueueReturnNowPlaying"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_metro_circle_button"
            android:src="@drawable/ic_np_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            app:tint="@color/text_primary"
            android:contentDescription="Return to Now Playing" />

        <TextView
            android:id="@+id/tvQueueReturnNowPlayingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="now playing"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockscreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1017">

    <!-- Vintage Vertical Tape Deck Player (Full Screen) -->
    <com.hana.spindle.ui.cassette.VerticalDeckView
        android:id="@+id/lockDeckView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="54dp" />

    <!-- Sleek Bottom Slide-to-Unlock Bar -->
    <LinearLayout
        android:id="@+id/layoutUnlockBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#141722"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲"
            android:textColor="#F97316"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvUnlockPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SWIPE UP TO UNLOCK"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />
    </LinearLayout>

</FrameLayout>

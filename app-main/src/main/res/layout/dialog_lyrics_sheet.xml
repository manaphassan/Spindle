<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F1117"
    android:padding="16dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#2E3342"
        android:layout_marginBottom="12dp" />

    <!-- Header: Title, Artist, Badge, and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track Title"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvSheetArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artist Name"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSheetLyricsBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYNCED LRC"
            android:textColor="#00E676"
            android:background="#122B1E"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnSheetClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"
            app:tint="#64748B" />
    </LinearLayout>

    <!-- Calibration Toolbar: Real-time time sync offset (-0.5s / +0.5s) -->
    <LinearLayout
        android:id="@+id/layoutOffsetToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161821"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYNC OFFSET:"
            android:textColor="#64748B"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOffsetMinus"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="-0.5s"
            android:textColor="#CBD5E1"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:backgroundTint="#242838"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:layout_marginStart="8dp"
            app:cornerRadius="4dp" />

        <TextView
            android:id="@+id/tvOffsetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="±0.0s"
            android:textColor="#F59E0B"
            android:textSize="10.5sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center"
            android:minWidth="44dp"
            android:layout_marginHorizontal="6dp" />

        <Button
            android:id="@+id/btnOffsetPlus"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="+0.5s"
            android:textColor="#CBD5E1"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:backgroundTint="#242838"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            app:cornerRadius="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnOffsetReset"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="RESET"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:backgroundTint="#1A1C26"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp"
            app:cornerRadius="4dp" />

        <ImageButton
            android:id="@+id/btnReloadLyrics"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Re-fetch from LRCLIB"
            android:layout_marginStart="6dp"
            app:tint="#38BDF8" />
    </LinearLayout>

    <!-- Main Content Frame: RecyclerView or Empty Download Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp">

        <!-- Synchronized Lyrics RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="24dp"
            android:scrollbars="none" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/emptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_np_lyrics"
                app:tint="#475569"
                android:layout_marginBottom="12dp"
                android:contentDescription="No lyrics" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No synchronized lyrics available for this track."
                android:textColor="#94A3B8"
                android:textSize="12.5sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnDownloadLyrics"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="DOWNLOAD FROM LRCLIB"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:backgroundTint="#16222F"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                app:cornerRadius="8dp" />

            <ProgressBar
                android:id="@+id/progressLoadingLyrics"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="gone"
                android:indeterminateTint="#38BDF8"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>

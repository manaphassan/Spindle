<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_widget_deck"
    android:padding="10dp">

    <!-- Cassette / Album Art Thumbnail -->
    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_widget_cover_frame"
        android:padding="2dp">

        <ImageView
            android:id="@+id/widgetIvCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_spindle_logo"
            android:contentDescription="Album Art" />
    </FrameLayout>

    <!-- Track Details & Mechanical Controls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="2dp">

        <!-- Header: Format Badge + Output Route Telemetry + Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetTvFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLAC • 96k"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/brand_yellow"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widgetTvRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 3.5mm"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPINDLE"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Track Title & Artist -->
        <TextView
            android:id="@+id/widgetTvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/spindle_deck_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/widgetTvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/spindle_deck_ready"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <!-- Tactile Transport Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/widgetBtnPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_np_prev"
                android:padding="6dp"
                android:contentDescription="Previous Track" />

            <ImageView
                android:id="@+id/widgetBtnPlayPause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_np_play"
                android:padding="6dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Play or Pause" />

            <ImageView
                android:id="@+id/widgetBtnNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_np_next"
                android:padding="6dp"
                android:contentDescription="Next Track" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/widgetPbProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="55dp"
                android:layout_height="4dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Drag & Reorder Handle -->
    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/text_secondary"
        android:contentDescription="Reorder handle"
        android:padding="4dp" />

    <!-- Track Index (Hidden, integrated into tvQueueTrackArtist) -->
    <TextView
        android:id="@+id/tvQueueIndex"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Playing Wave / Active Indicator -->
    <ImageView
        android:id="@+id/ivQueuePlaying"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_np_play"
        app:tint="@color/brand_orange"
        android:layout_marginStart="4dp"
        android:visibility="gone"
        android:contentDescription="Now Playing" />

    <!-- Metadata: Title & Artist in authentic Zune hierarchy -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvQueueTrackArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="1-06 The National"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvQueueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="I Should Live in Salt"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/tvQueueArtistDuration"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Duration -->
    <TextView
        android:id="@+id/tvQueueDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="04:05"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginEnd="8dp" />

    <!-- Format Chip -->
    <TextView
        android:id="@+id/tvQueueFormat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="FLAC"
        android:textColor="@color/brand_orange"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:background="@color/surface_card"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginEnd="10dp" />

    <!-- Remove from Queue Button -->
    <ImageButton
        android:id="@+id/btnQueueRemove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_queue_remove"
        app:tint="@color/text_secondary"
        android:contentDescription="Remove from queue"
        android:padding="8dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_container"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_eq_save_title"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Capture active 10-band ISO &amp; Parametric DSP curve"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundColor="@color/surface_card"
        app:boxStrokeColor="@color/brand_orange"
        app:hintTextColor="@color/brand_orange"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPresetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/user_eq_name_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:inputType="textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Notes / Target Description Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:boxBackgroundColor="@color/surface_card"
        app:boxStrokeColor="@color/brand_orange"
        app:hintTextColor="@color/brand_orange"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPresetDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/user_eq_desc_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:inputType="textCapSentences"
            android:maxLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Summary of current settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvSaveCurrentSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_orange"
            android:textSize="10.5sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            tools:text="MODE: PARAMETRIC • BASS: +20% • CROSSFEED: 30%" />

        <TextView
            android:id="@+id/tvSaveBandsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"
            tools:text="31Hz..16kHz: +3.5, +2.8, +1.2, 0.0, -0.5, 0.0, +1.0, -1.5, -0.8, +1.2 dB" />
    </LinearLayout>

    <!-- Dialog Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelSavePreset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/action_cancel"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface_elevated"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnConfirmSavePreset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/user_eq_btn_save_profile"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/brand_orange"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>

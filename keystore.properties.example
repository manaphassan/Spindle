# Spindle Release Keystore Configuration (Template)
# Copy this file to 'keystore.properties' and fill in your own private keystore credentials
# to sign production release APKs.
# 
# Note: 'keystore.properties' and '*.jks' are strictly ignored in .gitignore
# and must NEVER be committed to Git.
#
# If 'keystore.properties' is missing, release builds will safely fallback to the debug keystore.

storeFile=spindle-release.jks
storePassword=your_store_password
keyAlias=spindle
keyPassword=your_key_password

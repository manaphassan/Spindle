<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:paddingTop="36dp">

    <!-- Tab Selection Bar -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/tabApps"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="APPS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/wm2_red"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/tabMetrics"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="METRICS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface_elevated"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/tabEqThemes"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="EQ / THEMES"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface_elevated"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="12dp" />

    <!-- 1. APPS TAB CONTAINER -->
    <LinearLayout
        android:id="@+id/containerApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- App Search Bar -->
        <EditText
            android:id="@+id/etSearchApps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="@color/surface_elevated"
            android:hint="Search installed apps..."
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- 2. AUDIO METRICS TAB CONTAINER -->
    <ScrollView
        android:id="@+id/containerMetrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title & Bit-Perfect Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AUDIO TELEMETRY"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvBitPerfectBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● BIT-PERFECT NATIVE"
                    android:textColor="@color/vfd_emerald"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:background="#2E2E34"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Metrics Hi-Fi Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#121214"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:elevation="4dp">

                <!-- Format & Codec -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOURCE FORMAT"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMetricFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FLAC (Free Lossless Audio Codec)"
                    android:textColor="@color/vfd_cyan"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="12dp" />

                <!-- Bit Depth & Sample Rate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRECISION &amp; SAMPLE RATE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMetricSampleRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24-bit / 96.0 kHz"
                    android:textColor="@color/vfd_emerald"
                    android:fontFamily="monospace"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="12dp" />

                <!-- Dynamic Bitrate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DYNAMIC BITRATE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMetricBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2850 kbps"
                    android:textColor="@color/vfd_amber"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="12dp" />

                <!-- Output Hardware Route -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE HARDWARE ROUTE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMetricRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3.5mm Headphone Jack (Hi-Res)"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 3. EQ & THEMES TAB CONTAINER -->
    <ScrollView
        android:id="@+id/containerEqThemes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cassette Themes Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASSETTE SKIN &amp; CHASSIS"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Switch between iconic Walkman cassette styles"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Themes List Container -->
            <LinearLayout
                android:id="@+id/llThemeButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="24dp" />

            <!-- Audiophile DSP & EQ Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EQUALIZER &amp; DSP"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select target acoustic response"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Presets Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnEqFlat"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Flat"
                    android:textSize="12sp"
                    android:backgroundTint="@color/wm2_red"
                    app:cornerRadius="6dp" />

                <Button
                    android:id="@+id/btnEqBass"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Bass Boost"
                    android:textSize="12sp"
                    android:backgroundTint="@color/surface_elevated"
                    app:cornerRadius="6dp" />

                <Button
                    android:id="@+id/btnEqHarman"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Harman"
                    android:textSize="12sp"
                    android:backgroundTint="@color/surface_elevated"
                    app:cornerRadius="6dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>

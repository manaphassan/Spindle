<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:paddingTop="36dp">

    <!-- 1. APPS TAB / LISTING CONTAINER -->
    <LinearLayout
        android:id="@+id/containerApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- App Listing Header Bar: Title & Settings Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SPINDLE APPS"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="@color/text_primary"
                android:contentDescription="Settings &amp; Tuning" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- App Search Bar -->
        <EditText
            android:id="@+id/etSearchApps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="@color/surface_elevated"
            android:hint="Search installed apps..."
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- 2. DEDICATED SETTINGS PAGE (OPENED VIA ⚙️ ICON IN APP LISTING) -->
    <LinearLayout
        android:id="@+id/containerSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Settings Header Bar: Back to Apps & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btnBackFromSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_primary"
                android:contentDescription="Back to App List" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SETTINGS &amp; TUNING"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Scrollable Settings Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="48dp">

                <!-- 1. WALKMAN CASSETTE THEME SELECTOR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WALKMAN CASSETTE THEMES"
                        android:textColor="#A1A1AA"
                        android:textStyle="bold"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvActiveThemeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WM-2 Red (1981)"
                        android:textColor="@color/wm2_red"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:id="@+id/llThemeButtons"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- 2. DARK AUDIOPHILE DJ MIXER HARDWARE CONSOLE -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Console Header: Title & FX Preset Button -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="HARDWARE EQ &amp; ACOUSTIC DSP"
                                android:textColor="#71717A"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />

                            <Button
                                android:id="@+id/btnFx"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:text="FX: FLAT"
                                android:textColor="#00E676"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:backgroundTint="#1F2126"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <!-- Top Row: 3 Studio Potentiometers (LOW, MID, HI) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="88dp"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.hana.spindle.ui.eq.AudiophileKnobView
                                android:id="@+id/knobLow"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />

                            <com.hana.spindle.ui.eq.AudiophileKnobView
                                android:id="@+id/knobMid"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />

                            <com.hana.spindle.ui.eq.AudiophileKnobView
                                android:id="@+id/knobHi"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <!-- Middle Stage: Filter Knob + Waveform Visualizer + LED VU Meter -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="108dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginVertical="6dp">

                            <!-- Filter / Bass Boost Rotary Knob -->
                            <LinearLayout
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.hana.spindle.ui.eq.AudiophileKnobView
                                    android:id="@+id/knobFilter"
                                    android:layout_width="76dp"
                                    android:layout_height="76dp" />
                            </LinearLayout>

                            <!-- Center: Track Title & Waveform Visualizer -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginHorizontal="6dp">

                                <TextView
                                    android:id="@+id/tvDjTrackTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Spindle Direct DSD / ALSA"
                                    android:textColor="#E4E4E8"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:ellipsize="marquee"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:gravity="center"
                                    android:layout_marginBottom="4dp" />

                                <com.hana.spindle.ui.eq.AudioWaveformView
                                    android:id="@+id/waveformView"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp" />
                            </LinearLayout>

                            <!-- Right: 12-Segment Stereo dB LED VU Meter -->
                            <com.hana.spindle.ui.eq.LedVuMeterView
                                android:id="@+id/ledVuMeter"
                                android:layout_width="54dp"
                                android:layout_height="match_parent" />
                        </LinearLayout>

                        <!-- Transport Deck Section: CUE | DECK A / B | PLAY/PAUSE | BROWSE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <Button
                                android:id="@+id/btnCue"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_dj_circle_button"
                                android:text="CUE"
                                android:textColor="#A1A1AA"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                app:backgroundTint="@null" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DECK"
                                    android:textColor="#71717A"
                                    android:textSize="9.5sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="2dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <Button
                                        android:id="@+id/btnDeckA"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:background="@drawable/bg_dj_active_circle_button"
                                        android:text="A"
                                        android:textColor="#00E676"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        app:backgroundTint="@null" />

                                    <Button
                                        android:id="@+id/btnDeckB"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginStart="6dp"
                                        android:background="@drawable/bg_dj_circle_button"
                                        android:text="B"
                                        android:textColor="#71717A"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        app:backgroundTint="@null" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnDjPlayPause"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_dj_mint_button"
                                android:src="@android:drawable/ic_media_pause"
                                app:tint="#121316"
                                android:contentDescription="Play / Pause" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnBrowse"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_dj_circle_button"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                app:tint="#A1A1AA"
                                android:contentDescription="Browse Music Catalog" />
                        </LinearLayout>

                        <!-- Bottom Crossfader: Deck A ───|─── Deck B -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A"
                                android:textColor="#71717A"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <SeekBar
                                android:id="@+id/seekCrossfader"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100"
                                android:progress="50"
                                android:progressTint="#71717A"
                                android:thumbTint="#00E676"
                                android:layout_marginHorizontal="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="B"
                                android:textColor="#71717A"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. OFFLINE MUSIC STORAGE & SCANNER -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OFFLINE MUSIC STORAGE"
                            android:textColor="#71717A"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvSongCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading library index..."
                            android:textColor="@color/white"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="15sp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:id="@+id/tvScanProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Indexed across MicroSD and internal storage"
                            android:textColor="#A1A1AA"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <Button
                            android:id="@+id/btnRescanLibrary"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="RESCAN MUSIC STORAGE"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/wm2_red"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="8dp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 4. AUDIO TELEMETRY & BLUETOOTH BATTERY HEALTH -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="AUDIO HARDWARE TELEMETRY"
                                android:textColor="#71717A"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tvBitPerfectBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● BIT-PERFECT NATIVE"
                                android:textColor="@color/vfd_emerald"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textSize="11sp"
                                android:background="#2E2E34"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                        <!-- Format & Codec -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOURCE FORMAT"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="12dp" />
                        <TextView
                            android:id="@+id/tvMetricFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FLAC (Free Lossless Audio Codec)"
                            android:textColor="@color/vfd_cyan"
                            android:fontFamily="monospace"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="10dp" />

                        <!-- Bit Depth & Sample Rate -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRECISION &amp; SAMPLE RATE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvMetricSampleRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24-bit / 96.0 kHz"
                            android:textColor="@color/vfd_emerald"
                            android:fontFamily="monospace"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="10dp" />

                        <!-- Dynamic Bitrate -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DYNAMIC BITRATE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvMetricBitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2850 kbps"
                            android:textColor="@color/vfd_amber"
                            android:fontFamily="monospace"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="10dp" />

                        <!-- Output Hardware Route -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE HARDWARE ROUTE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvMetricRoute"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3.5mm Headphone Jack (Hi-Res)"
                            android:textColor="@color/white"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="10dp" />

                        <!-- Connected Bluetooth Audio Device & Battery Health -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BLUETOOTH AUDIO TELEMETRY &amp; BATTERY HEALTH"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvMetricBtBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Bluetooth Gear Connected (Using 3.5mm ALSA Direct)"
                            android:textColor="#A1A1AA"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 5. ABOUT SPINDLE & SYSTEM -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ABOUT SPINDLE LAUNCHER"
                            android:textColor="#71717A"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spindle OS v1.0.0 (Audiophile Edition)"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High-performance, low-RAM home launcher custom-tailored for repurposed Android devices and dedicated digital audio players (SO-02J).\n\n• 100% Offline with zero background tracking\n• Pure ALSA direct / native PCM hardware routing\n• Zero AI Bloatware • Apache 2.0 Open Source"
                            android:textColor="#A1A1AA"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.2"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>

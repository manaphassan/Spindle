<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:paddingTop="36dp">

    <!-- Tab Selection Bar -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/tabApps"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="APPS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/wm2_red"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/tabMetrics"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="METRICS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface_elevated"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/tabEqThemes"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="EQ / THEMES"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface_elevated"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="12dp" />

    <!-- 1. APPS TAB CONTAINER -->
    <LinearLayout
        android:id="@+id/containerApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- App Search Bar -->
        <EditText
            android:id="@+id/etSearchApps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="@color/surface_elevated"
            android:hint="Search installed apps..."
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- 2. AUDIO METRICS TAB CONTAINER -->
    <ScrollView
        android:id="@+id/containerMetrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title & Bit-Perfect Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AUDIO TELEMETRY"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvBitPerfectBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● BIT-PERFECT NATIVE"
                    android:textColor="@color/vfd_emerald"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:background="#2E2E34"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Metrics Hi-Fi Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#121214"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:elevation="4dp">

                <!-- Format & Codec -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOURCE FORMAT"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMetricFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FLAC (Free Lossless Audio Codec)"
                    android:textColor="@color/vfd_cyan"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="12dp" />

                <!-- Bit Depth & Sample Rate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRECISION &amp; SAMPLE RATE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMetricSampleRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24-bit / 96.0 kHz"
                    android:textColor="@color/vfd_emerald"
                    android:fontFamily="monospace"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="12dp" />

                <!-- Dynamic Bitrate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DYNAMIC BITRATE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMetricBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2850 kbps"
                    android:textColor="@color/vfd_amber"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="12dp" />

                <!-- Output Hardware Route -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE HARDWARE ROUTE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMetricRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3.5mm Headphone Jack (Hi-Res)"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 3. EQ & THEMES TAB CONTAINER -->
    <ScrollView
        android:id="@+id/containerEqThemes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. WALKMAN CASSETTE THEME SELECTOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WALKMAN THEMES"
                    android:textColor="#A1A1AA"
                    android:textStyle="bold"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvActiveThemeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WM-2 Red (1981)"
                    android:textColor="@color/wm2_red"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/llThemeButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 2. DARK AUDIOPHILE DJ MIXER HARDWARE CONSOLE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#141518"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Console Header: Title & FX Preset Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AUDIOPHILE DJ CONSOLE"
                            android:textColor="#71717A"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />

                        <Button
                            android:id="@+id/btnFx"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="FX: FLAT"
                            android:textColor="#00E676"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:backgroundTint="#1F2126"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="6dp" />
                    </LinearLayout>

                    <!-- Top Row: 3 Studio Potentiometers (LOW, MID, HI) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.hana.spindle.ui.eq.AudiophileKnobView
                            android:id="@+id/knobLow"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <com.hana.spindle.ui.eq.AudiophileKnobView
                            android:id="@+id/knobMid"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <com.hana.spindle.ui.eq.AudiophileKnobView
                            android:id="@+id/knobHi"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <!-- Middle Stage: Filter Knob + Waveform Visualizer + LED VU Meter -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginVertical="6dp">

                        <!-- Filter / Bass Boost Rotary Knob -->
                        <LinearLayout
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <com.hana.spindle.ui.eq.AudiophileKnobView
                                android:id="@+id/knobFilter"
                                android:layout_width="76dp"
                                android:layout_height="76dp" />
                        </LinearLayout>

                        <!-- Center: Track Title & Waveform Visualizer -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginHorizontal="6dp">

                            <TextView
                                android:id="@+id/tvDjTrackTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Spindle Direct DSD / ALSA"
                                android:textColor="#E4E4E8"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:ellipsize="marquee"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:gravity="center"
                                android:layout_marginBottom="4dp" />

                            <com.hana.spindle.ui.eq.AudioWaveformView
                                android:id="@+id/waveformView"
                                android:layout_width="match_parent"
                                android:layout_height="56dp" />
                        </LinearLayout>

                        <!-- Right: 12-Segment Stereo dB LED VU Meter -->
                        <com.hana.spindle.ui.eq.LedVuMeterView
                            android:id="@+id/ledVuMeter"
                            android:layout_width="54dp"
                            android:layout_height="match_parent" />
                    </LinearLayout>

                    <!-- Transport Deck Section: CUE | DECK A / B | PLAY/PAUSE | BROWSE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <!-- CUE Button -->
                        <Button
                            android:id="@+id/btnCue"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_dj_circle_button"
                            android:text="CUE"
                            android:textColor="#A1A1AA"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@null" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- DECK Label & Selectors -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DECK"
                                android:textColor="#71717A"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnDeckA"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_dj_active_circle_button"
                                    android:text="A"
                                    android:textColor="#00E676"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnDeckB"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_dj_circle_button"
                                    android:text="B"
                                    android:textColor="#71717A"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    app:backgroundTint="@null" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Radiant Mint Emerald PLAY/PAUSE Button -->
                        <ImageButton
                            android:id="@+id/btnDjPlayPause"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_dj_mint_button"
                            android:src="@android:drawable/ic_media_pause"
                            app:tint="#121316"
                            android:contentDescription="Play / Pause" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- BROWSE Button (Open Music Catalog) -->
                        <ImageButton
                            android:id="@+id/btnBrowse"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_dj_circle_button"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#A1A1AA"
                            android:contentDescription="Browse Music Catalog" />
                    </LinearLayout>

                    <!-- Bottom Crossfader: Deck A ───|─── Deck B -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="A"
                            android:textColor="#71717A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seekCrossfader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="#71717A"
                            android:thumbTint="#00E676"
                            android:layout_marginHorizontal="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="B"
                            android:textColor="#71717A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

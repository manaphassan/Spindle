<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:paddingTop="36dp">

    <!-- TOP 3-TAB SEGMENTED BAR -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#121316"
        android:padding="4dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnTabApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="APPS"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#E53935"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnTabEq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="EQ / DSP"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#1F2128"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="SETTINGS"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#1F2128"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- CONTENT FRAME FOR 3 TABS -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. TAB 1: ANDROID APP LIST -->
        <LinearLayout
            android:id="@+id/containerApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- App Search Bar -->
            <EditText
                android:id="@+id/etSearchApps"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="@color/surface_elevated"
                android:hint="Search installed apps..."
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:singleLine="true" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />
        </LinearLayout>

        <!-- 2. TAB 2: HARDWARE EQ & ACOUSTIC DSP CONSOLE -->
        <ScrollView
            android:id="@+id/containerEq"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Hardware DJ Mixer Console Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header & DSP Preset Button -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="HARDWARE EQ &amp; ACOUSTIC DSP"
                                android:textColor="#71717A"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />

                            <Button
                                android:id="@+id/btnFx"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:text="FX: FLAT"
                                android:textColor="#00E676"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:backgroundTint="#1B281E"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <!-- Top 3 Knobs: LOW, MID, HI -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.hana.spindle.ui.eq.AudiophileKnobView
                                android:id="@+id/knobLow"
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_weight="1" />

                            <com.hana.spindle.ui.eq.AudiophileKnobView
                                android:id="@+id/knobMid"
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_weight="1" />

                            <com.hana.spindle.ui.eq.AudiophileKnobView
                                android:id="@+id/knobHi"
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <!-- Middle Row: FILTER Knob + Live Waveform + Level VU Meter -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="124dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <com.hana.spindle.ui.eq.AudiophileKnobView
                                android:id="@+id/knobFilter"
                                android:layout_width="86dp"
                                android:layout_height="86dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginHorizontal="6dp">

                                <TextView
                                    android:id="@+id/tvDjTrackTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Spindle Direct ALSA / DSD DAC"
                                    android:textColor="#A1A1AA"
                                    android:textSize="11.5sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:singleLine="true"
                                    android:ellipsize="marquee"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:gravity="center"
                                    android:layout_marginBottom="4dp" />

                                <com.hana.spindle.ui.eq.AudioWaveformView
                                    android:id="@+id/waveformView"
                                    android:layout_width="match_parent"
                                    android:layout_height="64dp"
                                    android:background="#0C0D0E" />
                            </LinearLayout>

                            <com.hana.spindle.ui.eq.LedVuMeterView
                                android:id="@+id/ledVuMeter"
                                android:layout_width="62dp"
                                android:layout_height="match_parent"
                                android:background="#0C0D0E" />
                        </LinearLayout>

                        <!-- DJ Transport Controls: RESET Button + L/R Voltage Peak Meter + Play/Pause + Browse -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <!-- RESET button (replaces CUE) -->
                            <Button
                                android:id="@+id/btnReset"
                                android:layout_width="52dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_dj_circle_button"
                                android:text="RESET"
                                android:textColor="#A1A1AA"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                app:backgroundTint="@null" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <!-- L & R Voltage Peak Spectrum Meter (replaces Deck A/B buttons) -->
                            <com.hana.spindle.ui.eq.LrVoltagePeakMeterView
                                android:id="@+id/lrPeakMeter"
                                android:layout_width="72dp"
                                android:layout_height="52dp"
                                android:background="#0C0D0E" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnDjPlayPause"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_dj_mint_button"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#121316"
                                android:contentDescription="Play / Pause" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnBrowse"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_dj_circle_button"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                app:tint="#A1A1AA"
                                android:contentDescription="Browse Music Catalog" />
                        </LinearLayout>

                        <!-- L and R Audio Balance Slider (replaces A/B crossfader) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="L"
                                android:textColor="#00E676"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />

                            <SeekBar
                                android:id="@+id/seekCrossfader"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100"
                                android:progress="50"
                                android:progressTint="#71717A"
                                android:thumbTint="#00E676"
                                android:layout_marginHorizontal="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R"
                                android:textColor="#00E676"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- 3. TAB 3: LAUNCHER SETTINGS -->
        <ScrollView
            android:id="@+id/containerSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- 1. SET AS DEFAULT LAUNCHER ACTION CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#1C1E24"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ANDROID HOME INTEGRATION"
                            android:textColor="#71717A"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Primary Home Launcher"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Configure Spindle as the default home screen for this device. Pressing physical or software Home will directly open the Cassette Deck."
                            android:textColor="#A1A1AA"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                        <Button
                            android:id="@+id/btnSetDefaultLauncher"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="⚙️ SET AS DEFAULT LAUNCHER"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:backgroundTint="#E53935"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="8dp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. WALKMAN CASSETTE THEMES -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="WALKMAN CASSETTE THEMES"
                                android:textColor="#71717A"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tvActiveThemeName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WM-2 Red (1981)"
                                android:textColor="@color/wm2_red"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/llThemeButtons"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. RADIO STATIONS MANAGER -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="RADIO STATIONS CATALOG"
                                android:textColor="#71717A"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />

                            <Button
                                android:id="@+id/btnResetStations"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:text="RESET PRESETS"
                                android:textColor="#A1A1AA"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:backgroundTint="#202228"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="0dp"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llRadioStationsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 4. AUDIO HARDWARE TELEMETRY -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="AUDIO HARDWARE TELEMETRY"
                                android:textColor="#71717A"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tvBitPerfectBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● BIT-PERFECT NATIVE"
                                android:textColor="@color/vfd_emerald"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textSize="11sp"
                                android:background="#2E2E34"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                        <!-- Format & Codec -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOURCE FORMAT"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="12dp" />
                        <TextView
                            android:id="@+id/tvMetricFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FLAC (Free Lossless Audio Codec)"
                            android:textColor="@color/vfd_cyan"
                            android:fontFamily="monospace"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="10dp" />

                        <!-- Bit Depth & Sample Rate -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRECISION &amp; SAMPLE RATE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvMetricSampleRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24-bit / 96.0 kHz"
                            android:textColor="@color/vfd_emerald"
                            android:fontFamily="monospace"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="10dp" />

                        <!-- Dynamic Bitrate -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DYNAMIC BITRATE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvMetricBitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2850 kbps"
                            android:textColor="@color/vfd_amber"
                            android:fontFamily="monospace"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="10dp" />

                        <!-- Output Hardware Route -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE HARDWARE ROUTE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvMetricRoute"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3.5mm Headphone Jack (Hi-Res)"
                            android:textColor="@color/white"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222" android:layout_marginVertical="10dp" />

                        <!-- Connected Bluetooth Audio Device & Battery Health -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BLUETOOTH AUDIO TELEMETRY &amp; BATTERY HEALTH"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvMetricBtBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Bluetooth Gear Connected (Using 3.5mm ALSA Direct)"
                            android:textColor="#A1A1AA"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 5. OFFLINE MUSIC STORAGE & SCANNER -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#141518"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OFFLINE MUSIC STORAGE"
                            android:textColor="#71717A"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvSongCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading library index..."
                            android:textColor="@color/white"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="16sp"
                            android:layout_marginTop="4dp" />

                        <ProgressBar
                            android:id="@+id/progressScan"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            android:progressTint="@color/wm2_red"
                            android:layout_marginTop="8dp" />

                        <Button

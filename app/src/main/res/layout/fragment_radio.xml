<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111318"
    android:paddingTop="18dp"
    android:paddingBottom="16dp"
    android:paddingHorizontal="20dp">

    <!-- 1. Concentric Radial Acoustic Speaker Grille -->
    <com.hana.spindle.ui.radio.RadioSpeakerGrilleView
        android:id="@+id/speakerGrilleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="18dp" />

    <!-- 2. Preset Station Recessed Strip (4 Starter Stations) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#181A22"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnPreset0"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="LO-FI"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#2E3342"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnPreset1"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="ANIMEFM"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:backgroundTint="#222530"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnPreset2"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="INITIAL D"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:backgroundTint="#222530"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnPreset3"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="CITYPOP"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:backgroundTint="#222530"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Backlit LCD Panel (Dark VFD/OLED Vintage Matrix Display - Clickable to Toggle Play/Stop) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLcd"
        android:layout_width="match_parent"
        android:layout_height="146dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#0A0E17"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- LCD Header: FM & Live Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FM"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvRadioStreamStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ıll LIVE IN"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Large 7-Segment / LCD Frequency Readout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvRadioFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="88.5"
                    android:textColor="#F97316"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" MHz"
                    android:textColor="#FBBF24"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

            <!-- Now Playing Title Marquee -->
            <TextView
                android:id="@+id/tvRadioNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="♪ NO TRACK INFO"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginTop="1dp" />

            <!-- RDS Marquee / Station Metadata -->
            <TextView
                android:id="@+id/tvRadioRdsName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LO-FI RADIO • CHILL BEATS TO RELAX / STUDY"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 5. Analog 3D Tuning Thumbwheel Flanked by Skip Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnTunePrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_neumorphic_button"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#CBD5E1"
            android:contentDescription="Tune Previous" />

        <com.hana.spindle.ui.radio.RadioTuningDialView
            android:id="@+id/tuningDialView"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp" />

        <ImageButton
            android:id="@+id/btnTuneNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_neumorphic_button"
            android:src="@android:drawable/ic_media_next"
            app:tint="#CBD5E1"
            android:contentDescription="Tune Next" />
    </LinearLayout>

</LinearLayout>

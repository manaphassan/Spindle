<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E8E8EC"
    android:paddingTop="36dp"
    android:paddingBottom="20dp"
    android:paddingHorizontal="20dp">

    <!-- 1. Concentric Radial Acoustic Speaker Grille (Braun T3/TP1 proportion, safely uncropped) -->
    <com.hana.spindle.ui.radio.RadioSpeakerGrilleView
        android:id="@+id/speakerGrilleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="6dp" />

    <!-- 2. Preset Station Recessed Strip (4 Starter Stations) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#DADAE0"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnPreset0"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="LO-FI"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#F4F4F8"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnPreset1"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="ANIMEFM"
                android:textColor="#52525B"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:backgroundTint="#EDEDF2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnPreset2"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="INITIAL D"
                android:textColor="#52525B"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:backgroundTint="#EDEDF2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnPreset3"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="CITYPOP"
                android:textColor="#52525B"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:backgroundTint="#EDEDF2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Backlit LCD Panel (Greenish-Cream Vintage Matrix Display - Clickable to Toggle Play/Stop) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLcd"
        android:layout_width="match_parent"
        android:layout_height="136dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#DCE6DA"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- LCD Header: FM & Live Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FM"
                    android:textColor="#3F4D3C"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvRadioStreamStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ıll LIVE IN"
                    android:textColor="#2D5A27"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Large 7-Segment / LCD Frequency Readout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvRadioFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="98.2"
                    android:textColor="#1F2E1E"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" MHz"
                    android:textColor="#3F4D3C"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

            <!-- RDS Marquee / Station Metadata -->
            <TextView
                android:id="@+id/tvRadioRdsName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PEOPLE'S CENTRAL BROADCASTING STATION--VOICE OF CHINA"
                android:textColor="#2E3D2B"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 5. Analog 3D Tuning Thumbwheel Flanked by Skip Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnTunePrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_neumorphic_button"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#52525B"
            android:contentDescription="Tune Previous" />

        <com.hana.spindle.ui.radio.RadioTuningDialView
            android:id="@+id/tuningDialView"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp" />

        <ImageButton
            android:id="@+id/btnTuneNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_neumorphic_button"
            android:src="@android:drawable/ic_media_next"
            app:tint="#52525B"
            android:contentDescription="Tune Next" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lite_bg_chassis"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Console Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="APPLICATION DRAWER"
            android:textColor="@color/lite_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDrawerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_format_pill"
            android:fontFamily="monospace"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="CONSOLE"
            android:textColor="@color/brand_orange"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Master Volume Tactile Slider Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="VOL"
            android:textColor="@color/lite_amber_glow"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbMasterVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="70" />

        <TextView
            android:id="@+id/tvVolumePercent"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFamily="monospace"
            android:text="70%"
            android:textColor="@color/lite_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Search Bar Strip -->
    <EditText
        android:id="@+id/etSearchApps"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_search_bar"
        android:hint="Filter applications..."
        android:textColorHint="@color/lite_text_muted"
        android:textColor="@color/lite_text_primary"
        android:textSize="12sp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:singleLine="true"
        android:layout_marginBottom="6dp" />

    <!-- App Count & Status Subtext -->
    <TextView
        android:id="@+id/tvAppCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:paddingLeft="2dp"
        android:text="Scanning applications..."
        android:textColor="@color/lite_text_muted"
        android:textSize="10sp" />

    <!-- Recycler View for Installed Apps -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F50D0E15"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Bar: Zune Metro Typography Header + Close Button -->
    <LinearLayout
        android:id="@+id/headerJump"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvJumpTitle"
            style="@style/TextAppearance.SpindleLite.Metro.Hero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="jump" />

        <ImageButton
            android:id="@+id/btnJumpClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_close"
            android:tint="@color/lite_metro_text_secondary"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvJumpSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/headerJump"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="tap a letter to jump immediately"
        android:textColor="@color/lite_metro_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif" />

    <!-- 4-Column Metro Jump Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJumpGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvJumpSubtitle"
        android:layout_centerHorizontal="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radioPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lite_bg_chassis"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Header Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvRadioBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_format_pill"
            android:fontFamily="monospace"
            android:text="FM STEREO"
            android:textColor="@color/brand_orange"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="BAUHAUS TUNER"
            android:textColor="@color/lite_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Concentric Acoustic Speaker Grille -->
    <com.hana.spindle.lite.ui.LiteSpeakerGrilleView
        android:id="@+id/speakerGrilleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp" />

    <!-- Preset Stations Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnPresetLofi"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_preset_button"
            android:fontFamily="monospace"
            android:text="LO-FI"
            android:textColor="@color/brand_orange"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPresetAnime"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_preset_button"
            android:fontFamily="monospace"
            android:text="ANIME"
            android:textColor="@color/lite_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPresetInitialD"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_preset_button"
            android:fontFamily="monospace"
            android:text="INITIAL D"
            android:textColor="@color/lite_text_secondary"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPresetCitypop"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:background="@drawable/bg_preset_button"
            android:fontFamily="monospace"
            android:text="CITYPOP"
            android:textColor="@color/lite_text_secondary"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Backlit Recessed LCD Panel (Tap to Play/Pause) -->
    <LinearLayout
        android:id="@+id/radioLcdContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_radio_lcd"
        android:orientation="vertical"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="6dp">

        <!-- LCD Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="TUNER [LIVE]"
                android:textColor="@color/lite_text_muted"
                android:textSize="9sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRadioStreamStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="STANDBY"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Frequency Readout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRadioFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="88.5"
                android:textColor="@color/brand_orange"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingLeft="4dp"
                android:paddingBottom="4dp"
                android:text="MHz"
                android:textColor="@color/lite_amber_glow"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnRadioPlayToggle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_button_tactile"
                android:contentDescription="Play or Stop Radio"
                android:padding="8dp"
                android:src="@drawable/ic_play" />
        </LinearLayout>

        <!-- Station Name -->
        <TextView
            android:id="@+id/tvRadioStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="Lofi Girl 24/7 Chill Beats"
            android:textColor="@color/lite_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- RDS Meta / Track Title -->
        <TextView
            android:id="@+id/tvRadioRds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Online FM Stream • Shoutcast AAC/MP3"
            android:textColor="@color/lite_amber_glow"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Tactile Analog Tuning Dial -->
    <com.hana.spindle.lite.ui.LiteRadioDialView
        android:id="@+id/radioDialView"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

</LinearLayout>

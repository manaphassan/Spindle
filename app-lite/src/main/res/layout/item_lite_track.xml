<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="6dp"
    android:paddingRight="10dp">

    <!-- Cassette Formulation Spine Pill (Type IV Gold, Type II Blue, Type I Grey) -->
    <View
        android:id="@+id/vTapeSpine"
        android:layout_width="3.5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/brand_orange" />

    <!-- Track Index / Metro Counter -->
    <TextView
        android:id="@+id/tvTrackIndex"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="01"
        android:textColor="@color/lite_metro_text_muted"
        android:textSize="12.5sp" />

    <!-- Ultra-Low-RAM Album Art Thumbnail (36x36 dp) -->
    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="6dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_thumbnail_frame"
        android:src="@drawable/ic_album_placeholder"
        android:contentDescription="Artwork" />

    <!-- Title & Artist / Codec (Zune HD Typographic Hierarchy - Full Runway) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="2dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Song Title"
            android:textColor="@color/lite_metro_text_primary"
            android:textSize="15.5sp" />

        <TextView
            android:id="@+id/tvItemArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Artist Name • Album • FLAC"
            android:textColor="@color/lite_metro_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Zune HD Duration (Prominent, High Contrast) -->
    <TextView
        android:id="@+id/tvItemDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:includeFontPadding="false"
        android:text="03:45"
        android:textColor="@color/lite_metro_text_muted"
        android:textSize="12.5sp" />

    <!-- Retained for binding compatibility -->
    <TextView
        android:id="@+id/tvItemFormat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>

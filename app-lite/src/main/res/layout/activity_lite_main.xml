<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lite_bg_chassis">

    <!-- Main Deck Player Interface -->
    <LinearLayout
        android:id="@+id/playerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Top Header Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvFormatBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_format_pill"
                android:fontFamily="monospace"
                android:text="@string/format_flac"
                android:textColor="@color/brand_orange"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDeviceNameplate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="SPINDLE LITE"
                android:textColor="@color/lite_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Kinetic Cassette Deck View (Custom Canvas) -->
        <com.hana.spindle.lite.ui.LiteDeckView
            android:id="@+id/deckView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/lite_deck_surface" />

        <!-- Track Metadata Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/default_title"
                android:textColor="@color/lite_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTrackArtist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/default_artist"
                    android:textColor="@color/lite_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTimeReadout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00:00 / 00:00"
                    android:textColor="@color/lite_amber_glow"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Transport Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/btnEject"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_tactile"
                android:contentDescription="@string/transport_eject"
                android:src="@drawable/ic_eject" />

            <View
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_tactile"
                android:contentDescription="@string/transport_rewind"
                android:src="@drawable/ic_skip_previous" />

            <View
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:background="@drawable/bg_button_tactile"
                android:contentDescription="@string/transport_play"
                android:src="@drawable/ic_play" />

            <View
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_tactile"
                android:contentDescription="@string/transport_fast_forward"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sliding Music Library Drawer Overlay (Hidden by default) -->
    <LinearLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/drawer_title"
                android:textColor="@color/lite_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnScan"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/scan_library"
                android:textColor="@color/brand_orange"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnCloseDrawer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_tactile"
                android:contentDescription="Close"
                android:src="@drawable/ic_eject" />
        </LinearLayout>

        <!-- Track Count & Status -->
        <TextView
            android:id="@+id/tvVaultStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/ready"
            android:textColor="@color/lite_text_muted"
            android:textSize="11sp" />

        <!-- Library Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTrackList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lite_metro_bg">

    <!-- 3-Screen Horizontal Launcher ViewPager -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Zune Metro Music Vault Overlay (Opened via EJECT button) -->
    <LinearLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lite_metro_bg"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Zune Metro Kinetic Header (music + actions) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tvVaultHeroTitle"
                style="@style/TextAppearance.SpindleLite.Metro.Hero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="music" />

            <Button
                android:id="@+id/btnVaultJump"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="A–Z"
                android:textColor="@color/brand_orange"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnScan"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/scan_library"
                android:src="@drawable/ic_refresh"
                android:tint="@color/lite_metro_text_secondary" />

            <ImageButton
                android:id="@+id/btnCloseDrawer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Close Drawer"
                android:src="@drawable/ic_close"
                android:tint="@color/lite_metro_text_secondary" />
        </LinearLayout>

        <!-- Zune Typographic Pivot Bar (songs / albums / folders / queue) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="3dp">

            <LinearLayout
                android:id="@+id/vaultTabBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVaultTracks"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:fontFamily="sans-serif"
                    android:text="tracks"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_orange"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="12dp" />

                <Button
                    android:id="@+id/btnVaultArtists"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:fontFamily="sans-serif"
                    android:text="artists"
                    android:textAllCaps="false"
                    android:textColor="@color/lite_metro_text_muted"
                    android:textSize="18sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="12dp" />

                <Button
                    android:id="@+id/btnVaultAlbums"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:fontFamily="sans-serif"
                    android:text="albums"
                    android:textAllCaps="false"
                    android:textColor="@color/lite_metro_text_muted"
                    android:textSize="18sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="12dp" />

                <Button
                    android:id="@+id/btnVaultGenres"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:fontFamily="sans-serif"
                    android:text="genres"
                    android:textAllCaps="false"
                    android:textColor="@color/lite_metro_text_muted"
                    android:textSize="18sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="12dp" />

                <Button
                    android:id="@+id/btnVaultFolders"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:fontFamily="sans-serif"
                    android:text="folders"
                    android:textAllCaps="false"
                    android:textColor="@color/lite_metro_text_muted"
                    android:textSize="18sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="12dp" />

                <Button
                    android:id="@+id/btnVaultQueue"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:fontFamily="sans-serif"
                    android:text="queue"
                    android:textAllCaps="false"
                    android:textColor="@color/lite_metro_text_muted"
                    android:textSize="18sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="12dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Audiophile Filter Shelf (Hidden to maximize track list space, bound safely) -->
        <LinearLayout
            android:id="@+id/vaultFilterShelf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <Button
                android:id="@+id/btnFilterAll"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="ALL" />

            <Button
                android:id="@+id/btnFilterHiRes"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="HI-RES" />

            <Button
                android:id="@+id/btnFilterLossless"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="LOSSLESS" />

            <Button
                android:id="@+id/btnFilterNormal"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="NORMAL" />
        </LinearLayout>

        <!-- Search Bar Strip (Filter tracks) -->
        <EditText
            android:id="@+id/etSearchVault"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_metro_search"
            android:hint="filter tracks, artists, albums..."
            android:textColorHint="@color/lite_metro_text_muted"
            android:textColor="@color/lite_metro_text_primary"
            android:textSize="12sp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:layout_marginBottom="3dp" />

        <!-- Folder Path & Navigation Header (Shown when FOLDERS tab is active) -->
        <LinearLayout
            android:id="@+id/containerFolderPath"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnFolderUp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="[.. UP]"
                android:textColor="@color/brand_orange"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentFolderPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="/storage/sdcard1/Music"
                android:textColor="@color/lite_metro_text_primary"
                android:textSize="9.5sp" />

            <Button
                android:id="@+id/btnPlayFolder"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="PLAY ALL"
                android:textColor="@color/lite_led_green"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Track Count & Status -->
        <TextView
            android:id="@+id/tvVaultStatus"
            style="@style/TextAppearance.SpindleLite.Metro.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/ready" />

        <!-- Library Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTrackList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fastScrollEnabled="true"
            android:scrollbars="vertical" />

        <!-- Vault Now-Playing Mini-Ticker (Zune HD Metro 1-line strip) -->
        <LinearLayout
            android:id="@+id/containerVaultTicker"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_metro_ticker"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="6dp"
            android:layout_marginTop="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivTickerThumb"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginRight="8dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_thumbnail_frame"
                android:src="@drawable/ic_album_placeholder"
                android:contentDescription="Now Playing Art" />

            <TextView
                android:id="@+id/tvVaultTickerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="▶ NO TRACK PLAYING"
                android:textColor="@color/brand_orange"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnVaultTickerPlayPause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_play"
                android:tint="@color/brand_orange"
                android:contentDescription="Play/Pause" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

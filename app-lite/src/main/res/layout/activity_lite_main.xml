<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lite_metro_bg">

    <!-- 3-Screen Horizontal Launcher ViewPager -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Zune Metro Music Vault Overlay (Opened via EJECT button) -->
    <LinearLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lite_metro_bg"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Zune Metro Kinetic Header (music + actions) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tvVaultHeroTitle"
                style="@style/TextAppearance.SpindleLite.Metro.Hero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="music" />

            <Button
                android:id="@+id/btnVaultJump"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="A–Z"
                android:textColor="@color/brand_orange"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnScan"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/scan_library"
                android:textColor="@color/lite_metro_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseDrawer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Close Drawer"
                android:src="@drawable/ic_close"
                android:tint="@color/lite_metro_text_secondary" />
        </LinearLayout>

        <!-- Zune Typographic Pivot Bar (songs / folders / queue) -->
        <LinearLayout
            android:id="@+id/vaultTabBar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnVaultTracks"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:text="songs"
                android:textColor="@color/brand_orange"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingLeft="2dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/btnVaultFolders"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:text="folders"
                android:textColor="@color/lite_metro_text_muted"
                android:textSize="17sp"
                android:paddingLeft="6dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/btnVaultQueue"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:text="queue"
                android:textColor="@color/lite_metro_text_muted"
                android:textSize="17sp"
                android:paddingLeft="6dp"
                android:paddingRight="12dp" />
        </LinearLayout>

        <!-- Audiophile 1-Tap Quick Filter Shelf (32dp) -->
        <LinearLayout
            android:id="@+id/vaultFilterShelf"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnFilterAll"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="monospace"
                android:text="ALL"
                android:textColor="@color/brand_orange"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFilterHiRes"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="monospace"
                android:text="HI-RES 24b"
                android:textColor="@color/lite_metro_text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFilterLossless"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="monospace"
                android:text="LOSSLESS"
                android:textColor="@color/lite_metro_text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFilterNormal"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="monospace"
                android:text="NORMAL"
                android:textColor="@color/lite_metro_text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Bar Strip (Filter tracks) -->
        <EditText
            android:id="@+id/etSearchVault"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_metro_search"
            android:hint="filter tracks, artists, albums..."
            android:textColorHint="@color/lite_metro_text_muted"
            android:textColor="@color/lite_metro_text_primary"
            android:textSize="11.5sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:layout_marginBottom="4dp" />

        <!-- Folder Path & Navigation Header (Shown when FOLDERS tab is active) -->
        <LinearLayout
            android:id="@+id/containerFolderPath"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnFolderUp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="[.. UP]"
                android:textColor="@color/brand_orange"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentFolderPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="/storage/sdcard1/Music"
                android:textColor="@color/lite_metro_text_primary"
                android:textSize="9.5sp" />

            <Button
                android:id="@+id/btnPlayFolder"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_metro_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="PLAY ALL"
                android:textColor="@color/lite_led_green"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Track Count & Status -->
        <TextView
            android:id="@+id/tvVaultStatus"
            style="@style/TextAppearance.SpindleLite.Metro.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/ready" />

        <!-- Library Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTrackList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fastScrollEnabled="true"
            android:scrollbars="vertical" />
    </LinearLayout>

</FrameLayout>

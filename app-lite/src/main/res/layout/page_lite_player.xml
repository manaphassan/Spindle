<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp"
    android:background="@color/lite_bg_chassis">

    <!-- Top Header Equipment Status Bar (22dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvIndexBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_format_pill"
            android:fontFamily="monospace"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:text="INDEX: 000"
            android:textColor="@color/brand_orange"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/llDeviceIdentity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="2dp">

            <TextView
                android:id="@+id/tvDeviceNameplate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="SONY ERICSSON ST17i"
                android:textColor="@color/lite_text_primary"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAndroidVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Audiophile DAC Stream Telemetry Banner (20dp) -->
    <LinearLayout
        android:id="@+id/llDacTelemetry"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvDacFormat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="PCM DIRECT"
            android:textColor="@color/brand_orange"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDacSpecs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:fontFamily="monospace"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="16-BIT / 44.1 kHz • DIRECT"
            android:textColor="@color/lite_amber_glow"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/tvDacGain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="RG: 0.0dB"
            android:textColor="@color/lite_text_secondary"
            android:textSize="8.5sp" />
    </LinearLayout>

    <!-- Center Stage: Cassette Deck View & Vertical Hi-Fi Dual Stereo LED Meter Side-by-Side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Kinetic Cassette Deck with Integrated Studio Paper Now-Playing Label Frame -->
        <com.hana.spindle.lite.ui.LiteDeckView
            android:id="@+id/deckView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/lite_deck_surface" />

        <!-- Vertical Hi-Fi Status (BAT, RUN) & Dual-Channel Stereo Dynamic VU LED Ladder -->
        <com.hana.spindle.lite.ui.LiteLedMeterView
            android:id="@+id/ledMeterView"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- Standard Tactile Transport Controls (46dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/btnEject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_tactile"
            android:contentDescription="@string/transport_eject"
            android:padding="9dp"
            android:src="@drawable/ic_eject" />

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_tactile"
            android:contentDescription="@string/transport_rewind"
            android:padding="9dp"
            android:src="@drawable/ic_skip_previous" />

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:background="@drawable/bg_button_tactile"
            android:contentDescription="@string/transport_play"
            android:padding="8dp"
            android:src="@drawable/ic_play" />

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_tactile"
            android:contentDescription="@string/transport_fast_forward"
            android:padding="9dp"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp"
    android:background="@color/lite_metro_bg">

    <!-- Zune Metro Header & PlayMode Pill (28dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/tvPlayerHeroTitle"
            style="@style/TextAppearance.SpindleLite.Metro.Hero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="now playing" />

        <TextView
            android:id="@+id/tvIndexBadge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center"
            android:background="@drawable/bg_metro_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="[ALL]"
            android:textColor="@color/brand_orange"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- Hidden legacy views for safe binding compatibility -->
        <LinearLayout
            android:id="@+id/llDeviceIdentity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvDeviceNameplate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/tvAndroidVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- Audiophile DAC Stream Telemetry Banner (20dp) -->
    <LinearLayout
        android:id="@+id/llDacTelemetry"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@drawable/bg_metro_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvDacFormat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="PCM DIRECT"
            android:textColor="@color/brand_orange"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDacSpecs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="16-BIT / 44.1 kHz • DIRECT"
            android:textColor="@color/lite_metro_text_primary"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/tvDacGain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="0.0dB"
            android:textColor="@color/lite_metro_text_secondary"
            android:textSize="8.5sp" />
    </LinearLayout>

    <!-- Center Stage: Cassette Deck View & Vertical Hi-Fi Dual Stereo LED Meter Side-by-Side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Kinetic Cassette Deck with Integrated Studio Paper Now-Playing Label Frame -->
        <com.hana.spindle.lite.ui.LiteDeckView
            android:id="@+id/deckView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/lite_metro_surface" />

        <!-- Vertical Hi-Fi Status (BAT, RUN) & Dual-Channel Stereo Dynamic VU LED Ladder -->
        <com.hana.spindle.lite.ui.LiteLedMeterView
            android:id="@+id/ledMeterView"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- Flat Metro Geometric Transport Controls (46dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <ImageButton
            android:id="@+id/btnEject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_metro_tile"
            android:contentDescription="@string/transport_eject"
            android:padding="10dp"
            android:src="@drawable/ic_eject"
            android:tint="@color/lite_metro_text_secondary" />

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_metro_tile"
            android:contentDescription="@string/transport_rewind"
            android:padding="10dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/lite_metro_text_primary" />

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:background="@drawable/bg_metro_tile"
            android:contentDescription="@string/transport_play"
            android:padding="9dp"
            android:src="@drawable/ic_play"
            android:tint="@color/brand_orange" />

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_metro_tile"
            android:contentDescription="@string/transport_fast_forward"
            android:padding="10dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/lite_metro_text_primary" />
    </LinearLayout>

</LinearLayout>

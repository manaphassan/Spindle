<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lite_metro_surface_elevated" />
            <stroke android:width="1dp" android:color="@color/brand_orange" />
            <corners android:radius="@dimen/corner_radius_metro_pill" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lite_metro_accent" />
            <stroke android:width="1dp" android:color="@color/brand_orange" />
            <corners android:radius="@dimen/corner_radius_metro_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lite_metro_surface" />
            <stroke android:width="1dp" android:color="@color/lite_metro_border" />
            <corners android:radius="@dimen/corner_radius_metro_pill" />
        </shape>
    </item>
</selector>

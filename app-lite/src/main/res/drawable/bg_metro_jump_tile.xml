<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lite_metro_surface_elevated" />
            <stroke android:width="1.5dp" android:color="@color/brand_orange" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/lite_metro_tile_inactive" />
            <stroke android:width="1dp" android:color="@color/lite_metro_border_subtle" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lite_metro_surface" />
            <stroke android:width="1dp" android:color="@color/lite_metro_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>

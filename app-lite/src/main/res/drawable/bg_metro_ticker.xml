<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark Metro surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lite_metro_surface" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Crisp orange/subtle top border line -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/lite_metro_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
